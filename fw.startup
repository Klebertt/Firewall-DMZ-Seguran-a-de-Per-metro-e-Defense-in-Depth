#!/bin/sh
set -eu

# fw - firewall/middlebox
# eth0 = WAN  198.51.100.1/30
# eth1 = LAN  10.0.1.1/24
# eth2 = DMZ  10.0.2.1/24
# eth3 = MGMT 10.0.3.1/24

ip addr add 198.51.100.1/30 dev eth0 2>/dev/null || true
ip addr add 10.0.1.1/24 dev eth1 2>/dev/null || true
ip addr add 10.0.2.1/24 dev eth2 2>/dev/null || true
ip addr add 10.0.3.1/24 dev eth3 2>/dev/null || true

ip route replace default via 198.51.100.2 dev eth0
sysctl -w net.ipv4.ip_forward=1 >/dev/null

chmod +x /root/firewall/*.sh 2>/dev/null || true

# O laboratório sobe já com a política final de perímetro implementada.
# Para reproduzir a baseline inicial, execute /root/firewall/baseline.sh.
/root/firewall/perimeter.sh
