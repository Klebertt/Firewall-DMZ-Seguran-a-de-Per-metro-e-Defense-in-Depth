#!/bin/sh
set -eu

ip addr add 10.0.2.10/24 dev eth0 2>/dev/null || true
ip route replace default via 10.0.2.1 dev eth0

if ! grep -q '^nameserver ' /etc/resolv.conf 2>/dev/null; then
    printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /etc/resolv.conf
fi

if ! command -v nginx >/dev/null 2>&1 || ! command -v openssl >/dev/null 2>&1; then
    if command -v apk >/dev/null 2>&1; then
        apk add --no-cache nginx openssl
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get update
        DEBIAN_FRONTEND=noninteractive apt-get install -y nginx openssl
    else
        echo 'ERRO: não foi encontrado um gerenciador de pacotes para instalar o NGINX.' >&2
        exit 1
    fi
fi

if command -v service >/dev/null 2>&1; then
    service nginx stop >/dev/null 2>&1 || true
fi

mkdir -p /etc/nginx/ssl
if [ ! -s /etc/nginx/ssl/lab.crt ] || [ ! -s /etc/nginx/ssl/lab.key ]; then
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout /etc/nginx/ssl/lab.key \
        -out /etc/nginx/ssl/lab.crt \
        -subj '/CN=lab.test'
    chmod 600 /etc/nginx/ssl/lab.key
fi

cat > /etc/nginx/nginx.conf <<'EOF'
events {
    worker_connections 128;
}

http {
    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    limit_req_zone $binary_remote_addr zone=web_limit:10m rate=10r/s;

    server {
        listen 80;
        listen 443 ssl;
        ssl_certificate /etc/nginx/ssl/lab.crt;
        ssl_certificate_key /etc/nginx/ssl/lab.key;

        # Keep administrative paths inaccessible from this public proxy.
        location = /admin {
            return 403;
        }

        location ^~ /admin/ {
            return 403;
        }

        location / {
            # The backend only needs safe, read-only methods through the proxy.
            limit_except GET HEAD {
                deny all;
            }
            limit_req zone=web_limit burst=20 nodelay;
            # Apply browser security headers to responses handled by this location.
            add_header X-Content-Type-Options nosniff always;
            add_header X-Frame-Options DENY always;

            proxy_pass http://10.0.2.20:80;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
EOF

nginx -t
nginx -g 'daemon off;' > /tmp/nginx.log 2>&1 &
sleep 1
if ! kill -0 "$!" 2>/dev/null; then
    cat /tmp/nginx.log >&2
    echo 'ERRO: o NGINX Reverse Proxy não iniciou.' >&2
    exit 1
fi
